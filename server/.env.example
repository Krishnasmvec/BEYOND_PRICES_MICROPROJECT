# server/.env.example
# Copy to server/.env and fill in — this file holds the ONLY copy of the
# Gemini key. It is never bundled into client JS and must stay gitignored.
GEMINI_API_KEY=
PORT=8787
NODE_ENV=development
SESSION_COOKIE_NAME=hp_session

# Supabase anon key — safe to be world-readable by design (RLS is the real
# security boundary, not key secrecy), but kept server-side here anyway for
# consistency with how every other external service in this app is wired.
SUPABASE_URL=
SUPABASE_ANON_KEY=
